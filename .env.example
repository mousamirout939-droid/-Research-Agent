# Copy this file to `.env` and fill in your own keys. Never commit the real
# `.env` file -- it's already in .gitignore.

# --- LLM provider (required for real, non-mock runs) ------------------------
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-sonnet-4-6
WRITER_MODEL=claude-sonnet-4-6
VERIFIER_MODEL=claude-haiku-4-5-20251001
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=90

# --- Search provider ----------------------------------------------------------
# Leave TAVILY_API_KEY blank to fall back to the key-free DuckDuckGo provider.
TAVILY_API_KEY=
# auto | tavily | duckduckgo | mock
SEARCH_PROVIDER=auto
MAX_RESULTS_PER_QUERY=4

# --- Page fetching --------------------------------------------------------------
FETCH_TIMEOUT_SECONDS=12
MAX_PAGE_CHARS=8000
FETCH_CONCURRENCY=6

# --- Pipeline behaviour -----------------------------------------------------------
MAX_SUB_QUESTIONS=5
MAX_REVISIONS=2
FAITHFULNESS_THRESHOLD=0.85

# --- Caching ------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=604800

# --- App ------------------------------------------------------------------------------
APP_TITLE=Research Agent
LOG_LEVEL=INFO
